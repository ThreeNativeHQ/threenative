{
  "name": "threenative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && vitest run",
    "test:browser": "playwright test --config=playwright.config.ts",
    "lint": "biome check .",
    "budgets": "tsx scripts/check-budgets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "tsx": "4.23.5",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
