+
+for (const [step, folder] of [
+  ["Install the exact iOS consumer packages", "threenative-ios-release-consumer"],
+] as const) {
+  test(`${step} stages the complete smoke source import graph`, () => {
+    const directory = makeTempDirSync("threenative-consumer-sources-");
+    const target = join(directory, folder);
+    mkdirSync(join(target, "src"), { recursive: true });
+    const bin = join(directory, "bin");
+    mkdirSync(bin);
+    // Exercise the actual copy commands without installing packages in this unit test.
+    const pnpm = join(bin, "pnpm");
+    writeFileSync(pnpm, "#!/bin/sh\nexit 0\n");
+    chmodSync(pnpm, 0o755);
+    const result = spawnSync("bash", ["-e", "-o", "pipefail", "-c", script(step)], {
+      cwd: root,
+      encoding: "utf8",
+      env: {
+        ...process.env,
+        GITHUB_ENV: join(directory, "github-env"),
+        PATH: `${bin}:${process.env.PATH}`,
+        RUNNER_TEMP: directory,
+      },
+    });
+    assert.equal(result.status, 0, result.stdout + result.stderr);
+    const source = join(root, "examples/native-smoke/src");
+    for (const entry of readdirSync(source, { recursive: true, withFileTypes: true })) {
+      if (!entry.isFile()) continue;
+      const sourceFile = join(entry.parentPath, entry.name);
+      const relative = sourceFile.slice(source.length + 1);
+      assert.deepEqual(
+        readFileSync(join(target, "src", relative)),
+        readFileSync(sourceFile),
+        `consumer source omitted or changed: ${relative}`,
+      );
+    }
+  });
+}
