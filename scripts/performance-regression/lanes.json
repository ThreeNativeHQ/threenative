      "evidenceClass": "hosted-telemetry",
      "baseline": {
        "status": "unavailable",
        "reason": "Windows and macOS GPU identities require independent provisioned baselines."
      }
    },
    {
      "id": "native-android",
      "platform": "native-android",
      "arms": ["tn-android"],
      "workload": "platformer-production",
      "requiredMetrics": [
        "drawCalls",
        "triangles",
        "frameP95Ms",
        "phaseP95Ms",
        "startupP95Ms",
        "memoryHighWaterMiB"
