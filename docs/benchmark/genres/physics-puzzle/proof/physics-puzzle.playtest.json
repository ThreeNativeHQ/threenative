{
  "name": "physics-puzzle-contact-settle-replay-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": { "screenshots": "before-after", "runtimeTrace": true },
  "steps": [
    { "kind": "wait", "label": "drop", "waitTicks": 8, "release": true },
    { "kind": "wait", "label": "settled", "waitTicks": 90, "release": true },
    {
      "kind": "input",
      "label": "push-to-goal",
      "press": "ArrowRight",
      "holdTicks": 72,
      "release": true
    },
    { "kind": "wait", "label": "goal-contact", "waitTicks": 24, "release": true },
    {
      "kind": "input",
      "label": "replay-sequence",
      "press": "ArrowRight",
      "holdTicks": 72,
      "release": true
    },
    { "kind": "wait", "label": "replay-complete", "waitTicks": 24, "release": true }
  ],
  "assert": {
    "contacts": [
      { "entity": "player", "with": "solid-body", "kind": "contact", "minCount": 1 },
      { "entity": "mission", "with": "goal", "kind": "trigger", "minCount": 1 }
    ],
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minAxisDelta": { "axis": "+x", "min": 1.5 },
      "minDistance": 1.5
    },
    "resources": [
      {
        "id": "state",
        "path": "replayMatches",
        "equals": true,
        "changed": true,
        "atSteps": [
          { "label": "settled", "equals": false },
          { "label": "replay-sequence", "equals": true }
        ]
      }
    ],
    "settled": [
      {
        "atStep": "settled",
        "compareToStep": "drop",
        "entity": "crate",
        "minBodies": 30,
        "minMeanPoseDistance": 0.05
      }
    ],
    "states": [{ "entity": "mission", "equals": "won" }],
    "world": { "seed": 6132 }
  }
}
