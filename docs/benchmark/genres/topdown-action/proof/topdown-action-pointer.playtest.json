{
  "name": "topdown-action-pointer-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 12,
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "input",
      "label": "aim-and-fire",
      "pointerPosition": {
        "x": 0.7,
        "y": 0.5
      },
      "press": "Space",
      "holdTicks": 70,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "shots",
        "gte": 3,
        "changed": true
      },
      {
        "id": "state",
        "path": "reload",
        "gte": 0.1,
        "changed": true
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.001
        }
      }
    ]
  }
}
