{
  "name": "topdown-action-pointer-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "player",
  "artifacts": { "screenshots": "before-after" },
  "steps": [
    {
      "kind": "input",
      "label": "aim-and-fire",
      "pointerPosition": { "x": 0.7, "y": 0.5 },
      "press": "Space",
      "holdTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "rotationChanged": true },
    "animation": [{ "entity": "player", "clip": "attack", "entered": true, "advancedFrames": 1 }],
    "resources": [
      { "id": "state", "path": "shots", "gte": 1, "changed": true }
    ]
  }
}
