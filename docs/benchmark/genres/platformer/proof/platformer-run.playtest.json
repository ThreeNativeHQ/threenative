{
  "name": "platformer-run-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "input",
      "label": "run-collect-reach-restart",
      "press": "ArrowRight",
      "holdTicks": 360,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "playerX",
        "gte": 5,
        "changed": true
      },
      {
        "id": "state",
        "path": "coins",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "goalReached",
        "equals": true,
        "changed": true
      },
      {
        "id": "state",
        "path": "respawns",
        "gte": 1,
        "changed": true
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.001
        }
      }
    ]
  }
}
