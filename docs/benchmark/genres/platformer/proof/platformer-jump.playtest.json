{
  "name": "platformer-jump-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": { "screenshots": "before-after" },
  "steps": [
    { "kind": "input", "label": "jump", "press": "Space", "holdTicks": 4, "release": true },
    { "kind": "wait", "label": "jump-arc", "waitTicks": 14, "release": true }
  ],
  "assert": {
    "diagnostics": { "noNetworkErrors": true, "runtimeReady": true },
    "camera": {
      "entity": "camera.main",
      "follows": "player",
      "targetInViewport": true,
      "within": 12
    },
    "movement": {
      "entity": "player",
      "minAxisDelta": { "axis": "+y", "min": 0.5 }
    },
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
