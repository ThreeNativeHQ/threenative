{
  "name": "platformer-jump-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "input",
      "label": "jump",
      "press": "Space",
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "jump-arc",
      "waitTicks": 14,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "jumps",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "peakRise",
        "gte": 0.5,
        "changed": true
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.001
        }
      }
    ]
  }
}
