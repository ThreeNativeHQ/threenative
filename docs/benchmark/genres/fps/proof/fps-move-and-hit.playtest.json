{
  "name": "fps-move-and-hit-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1536,
    "height": 1024
  },
  "warmupFrames": 12,
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "input",
      "label": "advance",
      "press": "KeyW",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 4
    },
    {
      "kind": "input",
      "label": "fire-at-target",
      "press": "Space",
      "holdTicks": 30,
      "release": true
    },
    {
      "kind": "wait",
      "label": "impact",
      "waitTicks": 20
    }
  ],
  "assert": {
    "diagnostics": {
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "distanceMoved",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "targetsHit",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "score",
        "gte": 1,
        "changed": true
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.001
        }
      }
    ]
  }
}
