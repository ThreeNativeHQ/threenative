{
  "name": "open-world-brief-proof",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 15,
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "input",
      "label": "cross-three-chunk-boundaries",
      "press": "ArrowRight",
      "holdTicks": 180,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "distance",
        "gte": 300,
        "changed": true
      },
      {
        "id": "state",
        "path": "currentChunk",
        "gte": 7,
        "changed": true
      },
      {
        "id": "state",
        "path": "activeChunks",
        "changed": true
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.001
        }
      }
    ]
  }
}
