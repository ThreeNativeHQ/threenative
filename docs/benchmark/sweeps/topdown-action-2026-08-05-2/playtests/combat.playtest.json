{
  "name": "firing-all-targets",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "steps": [
    { "kind": "input", "label": "pointer-aim", "pointerPosition": { "x": 0.7, "y": 0.5 }, "waitTicks": 2 },
    { "kind": "input", "label": "fire", "press": "Space", "holdTicks": 45, "release": true },
    { "kind": "wait", "waitTicks": 25 }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "noRuntimeDiagnostics": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "shots", "gte": 3, "changed": true },
      { "id": "GameState", "path": "score", "gte": 3, "changed": true },
      { "id": "GameState", "path": "enemiesRemaining", "equals": 0, "changed": true }
    ],
    "states": [{ "entity": "enemy-1", "equals": "destroyed" }, { "entity": "enemy-2", "equals": "destroyed" }, { "entity": "enemy-3", "equals": "destroyed" }]
  }
}
