{
  "name": "movement",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "player",
  "steps": [{ "kind": "input", "label": "move-right", "press": "ArrowRight", "holdTicks": 45, "release": true }],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "noRuntimeDiagnostics": true, "runtimeReady": true },
    "movement": { "entity": "player", "axis": "x", "minAxisDelta": { "axis": "x", "min": 2 }, "minDistance": 2 },
    "resources": [{ "id": "GameState", "path": "playerX", "changed": true }],
    "visibility": [{ "entity": "player", "minProjectedPixels": 400, "maxOffscreenRatio": 0.05 }]
  }
}
