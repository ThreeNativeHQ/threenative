{
  "name": "respawn",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "run-into-the-gap",
      "press": "ArrowRight",
      "holdTicks": 420,
      "release": true
    },
    { "kind": "wait", "label": "respawn", "waitTicks": 120, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "respawns", "gte": 1, "changed": true },
      { "id": "GameState", "path": "playerX", "gte": 0, "changed": true }
    ],
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
