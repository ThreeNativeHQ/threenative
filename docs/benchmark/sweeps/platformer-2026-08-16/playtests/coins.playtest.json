{
  "name": "coins",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "run",
      "press": "ArrowRight",
      "holdTicks": 180,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "coins",
        "gte": 3,
        "changed": true
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 5
    },
    "visibility": [
      {
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}