{
  "name": "collision-restarts-without-reload",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "steps": [
    { "kind": "wait", "waitFrames": 180 },
    { "kind": "input", "press": "Enter", "holdFrames": 1, "release": true },
    { "kind": "wait", "waitFrames": 12 }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "runs", "gte": 2, "changed": true },
      { "id": "GameState", "path": "status", "equals": "running" },
      { "id": "GameState", "path": "distance", "lte": 5 }
    ]
  }
}
