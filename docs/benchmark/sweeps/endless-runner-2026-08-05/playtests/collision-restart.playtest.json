{
  "name": "endless-runner-collision-restart",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "wait", "label": "hit-first-barrier", "waitFrames": 300, "release": true },
    { "kind": "input", "label": "restart-without-reload", "press": "Space", "holdFrames": 1, "release": true },
    { "kind": "wait", "label": "new-run", "waitFrames": 20, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "collisions", "gte": 1, "changed": true },
      { "id": "GameState", "path": "respawns", "gte": 1, "changed": true },
      { "id": "GameState", "path": "run", "gte": 2, "changed": true },
      { "id": "GameState", "path": "distance", "changed": true }
    ],
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
