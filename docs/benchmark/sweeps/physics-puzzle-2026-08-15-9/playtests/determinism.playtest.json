{
  "name": "determinism",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "height": 900, "width": 1600 },
  "warmupFrames": 30,
  "artifacts": { "screenshots": "after", "console": true },
  "steps": [
    { "kind": "wait", "release": true, "waitTicks": 200, "label": "settle" },
    { "press": "KeyV", "release": true, "holdTicks": 4, "label": "start" },
    { "kind": "wait", "release": true, "waitTicks": 100, "label": "run1", "screenshot": "run1" },
    { "kind": "wait", "release": true, "waitTicks": 110, "label": "done", "screenshot": "done" }
  ],
  "assert": {
    "resources": [
      { "id": "state", "path": "replayPhase", "equals": "done" },
      { "id": "state", "path": "replayMatch", "equals": true },
      { "id": "state", "path": "replayHashA", "changed": true },
      { "id": "state", "path": "replayChecks", "gte": 1 }
    ],
    "diagnostics": { "noConsoleErrors": true, "noRuntimeDiagnostics": true }
  }
}
