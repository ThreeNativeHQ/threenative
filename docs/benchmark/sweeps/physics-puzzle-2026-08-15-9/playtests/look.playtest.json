{
  "name": "look",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "height": 900, "width": 1600 },
  "warmupFrames": 30,
  "artifacts": { "screenshots": "after", "console": true },
  "steps": [
    { "kind": "wait", "release": true, "waitTicks": 40, "label": "drop", "screenshot": "drop" },
    { "kind": "wait", "release": true, "waitTicks": 220, "label": "settle", "screenshot": "settled" },
    { "press": "ArrowRight", "release": false, "holdTicks": 90, "label": "push", "screenshot": "push" },
    { "kind": "wait", "release": true, "waitTicks": 60, "label": "rest", "screenshot": "rest" }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noRuntimeDiagnostics": true, "runtimeReady": true }
  }
}
