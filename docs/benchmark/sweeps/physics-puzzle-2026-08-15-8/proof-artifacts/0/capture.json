{
  "adapter": {
    "renderer": "ANGLE (Mesa, llvmpipe (LLVM 22.1.8 256 bits), OpenGL 4.6)",
    "vendor": "Google Inc. (Mesa)"
  },
  "browserArgs": [
    "--ozone-platform=x11",
    "--enable-unsafe-webgpu",
    "--disable-gpu-sandbox",
    "--ignore-gpu-blocklist",
    "--enable-features=Vulkan"
  ],
  "captureMethod": "page.screenshot",
  "rendererKind": "webgl",
  "target": "web",
  "viewport": {
    "height": 720,
    "width": 1280
  }
}
