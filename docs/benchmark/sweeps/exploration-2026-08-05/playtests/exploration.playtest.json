{
  "name": "exploration-journey",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 15,
  "subject": "player",
  "artifacts": { "screenshots": "before-after" },
  "steps": [
    { "kind": "input", "label": "inspect-hub-waystone", "press": "KeyE", "holdTicks": 2, "release": true },
    { "kind": "input", "label": "enter-moss-archive", "press": "ArrowUp", "holdFrames": 60, "release": true },
    { "kind": "input", "label": "inspect-archive-stone", "press": "KeyE", "holdTicks": 2, "release": true },
    { "kind": "input", "label": "return-from-archive", "press": "ArrowDown", "holdFrames": 90, "release": true },
    { "kind": "input", "label": "enter-glass-tide", "press": "ArrowDown", "holdFrames": 90, "release": true },
    { "kind": "input", "label": "inspect-tide-shard", "press": "KeyE", "holdTicks": 2, "release": true },
    { "kind": "input", "label": "return-to-hub", "press": "ArrowUp", "holdFrames": 90, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minDistance": 4 },
    "camera": { "entity": "camera.main", "follows": "player", "targetInViewport": true, "within": 10.5 },
    "resources": [
      { "id": "GameState", "path": "area", "equals": "hub" },
      { "id": "GameState", "path": "inspections", "equals": 3, "changed": true },
      { "id": "GameState", "path": "objectiveComplete", "equals": true },
      { "id": "GameState", "path": "returns", "equals": 2 },
      { "id": "GameState", "path": "transitionCount", "equals": 4 },
      { "id": "GameState", "path": "inspectedPoints", "textIncludes": "north.archive" }
    ],
    "visibility": [
      { "entity": "player", "minProjectedPixels": 20 },
      { "entity": "landmark.beacon", "minProjectedPixels": 40 },
      { "entity": "poi.hub.waystone", "minProjectedPixels": 12 }
    ],
    "visual": [
      { "frameDiff": { "minChangedPixelRatio": 0.01 } },
      { "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.65, "minDarkPixelRatio": 0.12 } }
    ]
  }
}
