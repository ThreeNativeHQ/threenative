{
  "name": "exploration-north",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 15,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "inspect-hub-waystone", "press": "KeyE", "holdFrames": 10, "release": true },
    { "kind": "input", "label": "enter-moss-archive", "press": "ArrowUp", "holdFrames": 53, "release": true },
    { "kind": "input", "label": "inspect-archive-stone", "press": "KeyE", "holdFrames": 10, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minDistance": 4 },
    "resources": [
      { "id": "GameState", "path": "area", "equals": "north" },
      { "id": "GameState", "path": "inspections", "equals": 2, "changed": true },
      { "id": "GameState", "path": "inspectedPoints", "textIncludes": "north.archive" },
      { "id": "GameState", "path": "transitionCount", "equals": 1 }
    ],
    "visual": [{ "frameDiff": { "minChangedPixelRatio": 0.01 } }]
  }
}
