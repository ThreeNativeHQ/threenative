{
  "name": "topdown-action-sweep",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "subject": "player",
  "artifacts": { "screenshots": "before-after", "runtimeTrace": true },
  "steps": [
    {
      "kind": "input",
      "label": "approach-arena",
      "press": "ArrowUp",
      "holdTicks": 35,
      "release": true
    },
    { "kind": "input", "label": "first-shot", "press": "KeyJ", "holdTicks": 2, "release": true },
    { "kind": "wait", "label": "first-reload", "waitTicks": 22, "release": true },
    { "kind": "input", "label": "second-shot", "press": "KeyJ", "holdTicks": 2, "release": true },
    { "kind": "wait", "label": "second-reload", "waitTicks": 22, "release": true },
    { "kind": "input", "label": "third-shot", "press": "KeyJ", "holdTicks": 2, "release": true },
    {
      "kind": "input",
      "label": "reach-exit",
      "press": "ArrowUp",
      "holdTicks": 120,
      "release": true
    },
    { "kind": "wait", "label": "goal-contact", "waitTicks": 15, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "enemiesRemaining", "equals": 0, "changed": true },
      { "id": "GameState", "path": "hits", "equals": 3, "changed": true },
      { "id": "GameState", "path": "shots", "equals": 3, "changed": true },
      { "id": "GameState", "path": "won", "equals": true, "changed": true }
    ],
    "movement": { "entity": "player", "minDistance": 4 },
    "camera": {
      "entity": "camera.main",
      "follows": "player",
      "targetInViewport": true,
      "within": 12
    },
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }],
    "visual": [{ "frameDiff": { "minChangedPixelRatio": 0.01 } }]
  }
}
