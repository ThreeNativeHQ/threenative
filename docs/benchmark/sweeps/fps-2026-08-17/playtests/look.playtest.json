{
  "name": "look",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "player",
  "artifacts": { "screenshots": false },
  "steps": [
    {
      "kind": "input",
      "label": "look-start",
      "pointerPosition": { "buttons": 1, "x": 0.25, "y": 0.5 },
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "look-right",
      "pointerPosition": { "buttons": 1, "x": 0.75, "y": 0.5 },
      "holdTicks": 3,
      "release": true
    },
    { "kind": "wait", "label": "settle", "waitTicks": 4, "release": true }
  ],
  "assert": {
    "camera": { "entity": "camera.main" },
    "diagnostics": {
      "noConsoleErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": { "entity": "camera.main", "rotationChanged": true }
  }
}
