{
  "name": "visibility",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "player",
  "steps": [{ "kind": "wait", "waitTicks": 18, "screenshot": "arena" }],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "noRuntimeDiagnostics": true, "runtimeReady": true },
    "camera": { "entity": "camera.main", "follows": "player", "targetInViewport": true, "within": 18 },
    "visibility": [
      { "entity": "player", "minProjectedPixels": 400, "maxOffscreenRatio": 0.05 },
      { "entity": "enemy-2", "minProjectedPixels": 300, "maxOffscreenRatio": 0.05 }
    ],
    "visual": [{ "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.5 } }]
  }
}
