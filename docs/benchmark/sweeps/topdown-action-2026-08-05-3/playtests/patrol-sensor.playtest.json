{
  "name": "patrol-sensor-moves",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "patrol-sensor",
  "steps": [{ "kind": "wait", "label": "sensor-patrol", "waitTicks": 90 }],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "patrol-sensor",
      "axis": "x",
      "minAxisDelta": { "axis": "x", "min": 2 },
      "minDistance": 2
    },
    "resources": [
      { "id": "GameState", "path": "sensorTravel", "gte": 2.5, "changed": true },
      { "id": "GameState", "path": "sensorX", "changed": true }
    ],
    "visibility": [
      { "entity": "patrol-sensor", "minProjectedPixels": 120, "maxOffscreenRatio": 0.05 }
    ]
  }
}
