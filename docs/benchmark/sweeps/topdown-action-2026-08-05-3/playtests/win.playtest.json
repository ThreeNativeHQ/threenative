{
  "name": "win-condition",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "steps": [
    { "kind": "input", "label": "clear-arena", "press": "Space", "holdTicks": 70, "release": true },
    { "kind": "wait", "waitTicks": 20 }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "noRuntimeDiagnostics": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "won", "equals": true, "changed": true },
      { "id": "GameState", "path": "objective", "textIncludes": "SECURE", "changed": true }
    ],
    "states": [{ "entity": "mission", "equals": "won" }]
  }
}
