; PRD-117 Godot control arm. Defaults are deliberately left alone except for the pinned
; viewport and the disabled frame cap — §4.4 forbids hand-tuning either side.
config_version=5

[application]

config/name="Engine Load Test"
run/main_scene="res://main.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
textures/vram_compression/import_etc2_astc=true
; PRD-464 R1: the same shadow map on both engines, 2048. Irrelevant to the L rungs, which cast
; nothing, so the cube scoreboard's rows are unaffected by it being set here.
lights_and_shadows/directional_shadow/size=2048
