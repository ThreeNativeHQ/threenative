{
  "name": "@threenative/three-native",
  "version": "0.3.4",
  "private": true,
  "license": "MIT",
  "description": "The native engine's machine-readable compatibility catalog and the generators that adapt it to TypeScript declarations and the C binding ABI.",
  "keywords": ["threenative", "three", "native", "abi", "gamedev"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/three-native"
  },
  "type": "module",
  "scripts": {
    "generate": "pnpm --workspace-root exec tsx packages/three-native/scripts/generate.ts",
    "typecheck": "pnpm run generate && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
