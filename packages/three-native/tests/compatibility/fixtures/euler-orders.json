{
  "name": "euler-orders",
  "adaptedFrom": "three@0.185.1 test/unit/src/math/Euler.tests.js — setFromRotationMatrix over all six orders",
  "tolerance": { "abs": 0, "ulps": 1 },
  "toleranceWhy": "libm and V8 disagree in the last bit for sin/cos/tan/atan/asin/acos/atan2/pow: measured over 6000 random arguments each, glibc differs from V8 by exactly 1 ulp on 3-6% of them, while sqrt never differs. This fixture's expected values pass through one of those, so it compares within 1 ulp; the signed zero and NaN rules still hold exactly.",
  "ops": [
    { "op": "new", "id": "source", "class": "Euler", "args": [0.3, -0.4, 1.2, "XYZ"] },
    { "op": "new", "id": "q", "class": "Quaternion", "args": [] },
    { "op": "call", "id": "q", "method": "setFromEuler", "args": [{ "ref": "source" }] },
    { "op": "new", "id": "origin", "class": "Vector3", "args": [0, 0, 0] },
    { "op": "new", "id": "extent", "class": "Vector3", "args": [1, 1, 1] },
    { "op": "new", "id": "m", "class": "Matrix4", "args": [] },
    {
      "op": "call",
      "id": "m",
      "method": "compose",
      "args": [{ "ref": "origin" }, { "ref": "q" }, { "ref": "extent" }]
    },
    { "op": "new", "id": "e_XYZ", "class": "Euler", "args": [] },
    {
      "op": "call",
      "id": "e_XYZ",
      "method": "setFromRotationMatrix",
      "args": [{ "ref": "m" }, "XYZ"]
    },
    { "op": "new", "id": "e_YZX", "class": "Euler", "args": [] },
    {
      "op": "call",
      "id": "e_YZX",
      "method": "setFromRotationMatrix",
      "args": [{ "ref": "m" }, "YZX"]
    },
    { "op": "new", "id": "e_ZXY", "class": "Euler", "args": [] },
    {
      "op": "call",
      "id": "e_ZXY",
      "method": "setFromRotationMatrix",
      "args": [{ "ref": "m" }, "ZXY"]
    },
    { "op": "new", "id": "e_XZY", "class": "Euler", "args": [] },
    {
      "op": "call",
      "id": "e_XZY",
      "method": "setFromRotationMatrix",
      "args": [{ "ref": "m" }, "XZY"]
    },
    { "op": "new", "id": "e_YXZ", "class": "Euler", "args": [] },
    {
      "op": "call",
      "id": "e_YXZ",
      "method": "setFromRotationMatrix",
      "args": [{ "ref": "m" }, "YXZ"]
    },
    { "op": "new", "id": "e_ZYX", "class": "Euler", "args": [] },
    {
      "op": "call",
      "id": "e_ZYX",
      "method": "setFromRotationMatrix",
      "args": [{ "ref": "m" }, "ZYX"]
    }
  ],
  "observe": [
    { "id": "source", "method": "toArray", "kind": "numbers" },
    { "id": "e_XYZ", "method": "toArray", "kind": "numbers" },
    { "id": "e_XYZ", "path": "order", "kind": "string" },
    { "id": "e_YZX", "method": "toArray", "kind": "numbers" },
    { "id": "e_YZX", "path": "order", "kind": "string" },
    { "id": "e_ZXY", "method": "toArray", "kind": "numbers" },
    { "id": "e_ZXY", "path": "order", "kind": "string" },
    { "id": "e_XZY", "method": "toArray", "kind": "numbers" },
    { "id": "e_XZY", "path": "order", "kind": "string" },
    { "id": "e_YXZ", "method": "toArray", "kind": "numbers" },
    { "id": "e_YXZ", "path": "order", "kind": "string" },
    { "id": "e_ZYX", "method": "toArray", "kind": "numbers" },
    { "id": "e_ZYX", "path": "order", "kind": "string" }
  ]
}
