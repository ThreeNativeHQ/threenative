{
  "name": "lit-render",
  "adaptedFrom": "original — one lit WebGPU frame: camera, directional light, MeshStandardMaterial box",
  "tolerance": { "abs": 0 },
  "render": true,
  "ops": [
    { "op": "new", "id": "scene", "class": "Scene", "args": [] },
    { "op": "new", "id": "background", "class": "Color", "args": [0.05, 0.06, 0.08] },
    { "op": "set", "id": "scene", "path": "background", "value": { "ref": "background" } },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [60, 1.7777777777777777, 0.1, 100]
    },
    { "op": "set", "id": "camera", "path": "position.y", "value": 2 },
    { "op": "set", "id": "camera", "path": "position.z", "value": 5 },
    { "op": "call", "id": "camera", "method": "lookAt", "args": [0, 0, 0] },
    { "op": "new", "id": "light", "class": "DirectionalLight", "args": [16777215, 3] },
    { "op": "set", "id": "light", "path": "position.x", "value": 2 },
    { "op": "set", "id": "light", "path": "position.y", "value": 3 },
    { "op": "set", "id": "light", "path": "position.z", "value": 1 },
    { "op": "new", "id": "geometry", "class": "BoxGeometry", "args": [1, 1, 1] },
    { "op": "new", "id": "material", "class": "MeshStandardMaterial", "args": [] },
    { "op": "set", "id": "material", "path": "roughness", "value": 0.4 },
    { "op": "set", "id": "material", "path": "metalness", "value": 0.1 },
    {
      "op": "new",
      "id": "mesh",
      "class": "Mesh",
      "args": [{ "ref": "geometry" }, { "ref": "material" }]
    },
    { "op": "call", "id": "mesh", "method": "rotateY", "args": [0.6] },
    { "op": "call", "id": "scene", "method": "add", "args": [{ "ref": "mesh" }] },
    { "op": "call", "id": "scene", "method": "add", "args": [{ "ref": "light" }] },
    { "op": "call", "id": "camera", "method": "add", "args": [{ "ref": "camera" }] },
    { "op": "call", "id": "camera", "method": "updateProjectionMatrix", "args": [] },
    { "op": "call", "id": "scene", "method": "updateMatrixWorld", "args": [true] }
  ],
  "observe": [
    { "id": "camera", "path": "projectionMatrix.elements", "kind": "numbers" },
    { "id": "camera", "path": "matrixWorld.elements", "kind": "numbers" },
    { "id": "light", "path": "matrixWorld.elements", "kind": "numbers" },
    { "id": "mesh", "path": "matrixWorld.elements", "kind": "numbers" },
    { "id": "geometry", "path": "parameters", "kind": "json" },
    { "id": "material", "path": "type", "kind": "string" }
  ]
}
