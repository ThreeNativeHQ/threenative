{
  "name": "materials-vertex-colors",
  "adaptedFrom": "original — material.vertexColors on a plane whose four corners carry a color attribute (vec3): a lit MeshStandardMaterial and a MeshBasicMaterial tinted red, each multiplying its colour by three's vertexColor()",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [60, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 1.4
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 3.2
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0, 0]
    },
    {
      "op": "new",
      "id": "light",
      "class": "DirectionalLight",
      "args": [16777215, 3]
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.x",
      "value": 2
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.y",
      "value": 3
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.z",
      "value": 1
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189137, 2236962, 0.6]
    },
    {
      "op": "new",
      "id": "plane",
      "class": "PlaneGeometry",
      "args": [1.6, 1.6, 1, 1]
    },
    {
      "op": "new",
      "id": "rgb",
      "class": "Float32BufferAttribute",
      "args": [
        {
          "array": [1, 0.2, 0.1, 0.1, 1, 0.2, 0.2, 0.1, 1, 1, 1, 0.2],
          "type": "Float32Array"
        },
        3
      ]
    },
    {
      "op": "call",
      "id": "plane",
      "method": "setAttribute",
      "args": [
        "color",
        {
          "ref": "rgb"
        }
      ]
    },
    {
      "op": "new",
      "id": "lit",
      "class": "MeshStandardMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "lit",
      "path": "vertexColors",
      "value": true
    },
    {
      "op": "set",
      "id": "lit",
      "path": "roughness",
      "value": 0.5
    },
    {
      "op": "new",
      "id": "litMesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "plane"
        },
        {
          "ref": "lit"
        }
      ]
    },
    {
      "op": "set",
      "id": "litMesh",
      "path": "position.x",
      "value": -0.9
    },
    {
      "op": "new",
      "id": "flat",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "flat",
      "path": "vertexColors",
      "value": true
    },
    {
      "op": "set",
      "id": "flat",
      "path": "color.r",
      "value": 0.8
    },
    {
      "op": "new",
      "id": "flatMesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "plane"
        },
        {
          "ref": "flat"
        }
      ]
    },
    {
      "op": "set",
      "id": "flatMesh",
      "path": "position.x",
      "value": 0.9
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "litMesh"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "flatMesh"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "light"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "camera",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "light",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ]
}
