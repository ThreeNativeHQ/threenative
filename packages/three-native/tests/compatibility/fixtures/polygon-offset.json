{
  "name": "polygon-offset",
  "adaptedFrom": "original — material.polygonOffset as three r185's WebGPUPipelineUtils maps it (depthBias = polygonOffsetUnits, depthBiasSlopeScale = polygonOffsetFactor): a green plane with a negative offset drawn before a coplanar red one wins the depth test that the red plane wins without it. The red plane is DoubleSide so the two materials never share one render pipeline (three's pipeline cache key omits polygonOffset)",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 256,
    "height": 128,
    "toneMapping": "none",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.1, 0.1, 0.1]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "OrthographicCamera",
      "args": [-2, 2, 1, -1, 0.1, 10]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5
    },
    {
      "op": "new",
      "id": "plane",
      "class": "PlaneGeometry",
      "args": [3, 2]
    },
    {
      "op": "new",
      "id": "greenMaterial",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "greenColor",
      "class": "Color",
      "args": [0, 1, 0]
    },
    {
      "op": "set",
      "id": "greenMaterial",
      "path": "color",
      "value": {
        "ref": "greenColor"
      }
    },
    {
      "op": "set",
      "id": "greenMaterial",
      "path": "polygonOffset",
      "value": true
    },
    {
      "op": "set",
      "id": "greenMaterial",
      "path": "polygonOffsetFactor",
      "value": -2
    },
    {
      "op": "set",
      "id": "greenMaterial",
      "path": "polygonOffsetUnits",
      "value": -2
    },
    {
      "op": "new",
      "id": "greenMesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "plane"
        },
        {
          "ref": "greenMaterial"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "greenMesh"
        }
      ]
    },
    {
      "op": "new",
      "id": "redMaterial",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "redColor",
      "class": "Color",
      "args": [1, 0, 0]
    },
    {
      "op": "set",
      "id": "redMaterial",
      "path": "color",
      "value": {
        "ref": "redColor"
      }
    },
    {
      "op": "set",
      "id": "redMaterial",
      "path": "side",
      "value": 2
    },
    {
      "op": "new",
      "id": "redMesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "plane"
        },
        {
          "ref": "redMaterial"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "redMesh"
        }
      ]
    }
  ],
  "observe": [
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ]
}
