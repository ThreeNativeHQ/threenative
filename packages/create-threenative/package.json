{
  "name": "create-threenative",
  "version": "0.1.0",
  "description": "Scaffold a readable ThreeNative game project.",
  "type": "module",
  "files": ["dist", "templates"],
  "bin": {
    "create-threenative": "./dist/index.js",
    "threenative": "./dist/threenative.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:"
  }
}
