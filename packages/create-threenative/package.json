{
  "name": "create-threenative",
  "version": "0.2.3",
  "license": "MIT",
  "description": "Scaffold a readable ThreeNative game project.",
  "keywords": [
    "threenative",
    "three",
    "threejs",
    "scaffold",
    "create",
    "starter",
    "gamedev",
    "template"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/create-threenative"
  },
  "type": "module",
  "files": [
    "dist",
    "templates",
    "template-assets",
    "agent-docs",
    "agent-files",
    "capabilities.json",
    "README.md"
  ],
  "bin": {
    "create-threenative": "./dist/index.js",
    "threenative": "./dist/threenative.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-brand": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict"
  },
  "dependencies": {
    "@gltf-transform/core": "catalog:",
    "@gltf-transform/extensions": "catalog:",
    "@gltf-transform/functions": "catalog:",
    "draco3dgltf": "^1.5.7",
    "ktx-parse": "^1.1.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.1.1",
    "three": "catalog:"
  },
  "devDependencies": {
    "@gltf-transform/core": "catalog:",
    "@threenative/assets": "workspace:*",
    "@threenative/core": "workspace:*",
    "@threenative/physics": "workspace:*",
    "@types/node": "20.19.43",
    "@types/three": "0.185.3",
    "esbuild": "catalog:",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@threenative/assets": ">=0.3.0 <0.4.0"
  }
}
