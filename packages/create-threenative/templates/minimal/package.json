{
  "name": "__PROJECT_NAME__",
  "private": true,
  "type": "module",
  "threenative": {
    "nativeEntry": "src/game.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "pretest": "playwright install chromium",
    "test": "vite build && threenative-playtest --scenario playtests/play.playtest.json --url http://127.0.0.1:4173 --server-command \"pnpm dev --host 127.0.0.1 --port 4173 --strictPort\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@threenative/core": "0.1.0",
    "@threenative/physics": "0.1.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.3",
    "@threenative/playtest": "0.1.0",
    "create-threenative": "0.1.0",
    "playwright": "1.62.1",
    "threenative-asset-mcp": "0.4.0",
    "threenative-sculpt-mcp": "0.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.1.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@threenative/runtime-native"]
  }
}
