{
  "name": "indirect-light",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "artifacts": { "screenshots": "before-after" },
  "warmupFrames": 60,
  "steps": [
    {
      "kind": "input",
      "label": "freeze lighting",
      "press": "KeyL",
      "holdTicks": 1,
      "release": true
    },
    { "kind": "wait", "label": "surfel settle", "waitTicks": 120, "release": true },
    {
      "kind": "input",
      "label": "change wall colour",
      "press": "KeyC",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "bounce settle",
      "waitTicks": 300,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "giCoverage",
        "gte": 0.001,
        "allowTrivial": "Static-scene coverage is established during the warmup and intentionally remains bounded while the camera sweep proves the live consumer."
      },
      {
        "id": "state",
        "path": "giBounceDeltaRed",
        "gte": 0.0001,
        "changed": true
      }
    ],
    "visual": [
      {
        "region": {
          "x": 230,
          "y": 470,
          "width": 70,
          "height": 50,
          "minNonblankPixelRatio": 0.2
        },
        "frameDiff": { "minChangedPixelRatio": 0.001 }
      }
    ],
    "renderChain": { "tier": "high" }
  }
}
