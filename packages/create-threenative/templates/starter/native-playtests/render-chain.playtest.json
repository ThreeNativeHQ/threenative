{
  "name": "native-render-chain",
  "target": "desktop",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 2,
  "steps": [
    {
      "kind": "input",
      "label": "move-across-the-platform",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "label": "frame-settles",
      "waitTicks": 600
    }
  ],
  "artifacts": {
    "screenshots": "after"
  },
  "assert": {
    "renderChain": {
      "tier": "high",
      "stages": {
        "includes": ["ambientOcclusion", "bloom", "vignette"]
      }
    },
    "resources": [
      {
        "id": "state",
        "path": "odometer",
        "gte": 1,
        "changed": true
      }
    ],
    "visibility": [
      {
        "entity": "player",
        "minProjectedPixels": 20,
        "allowTrivial": "The player is visible from the first tick; the state rows carry the native render proof."
      }
    ]
  }
}
