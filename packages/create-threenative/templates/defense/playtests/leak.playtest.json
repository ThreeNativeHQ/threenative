{
  "name": "defense-leak-limit",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "camera.main",
  "steps": [{ "kind": "wait", "label": "deliberate-leaks", "waitTicks": 1000, "release": true }],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "status", "equals": "LOST", "changed": true },
      { "id": "state", "path": "leaks", "gte": 20, "changed": true },
      { "id": "state", "path": "spent", "equals": 0, "allowTrivial": true },
      { "id": "state", "path": "wave", "gte": 10, "changed": true }
    ]
  }
}
