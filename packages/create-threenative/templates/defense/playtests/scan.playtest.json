{
  "name": "defense-scan-interval",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "tower.0",
  "steps": [
    { "kind": "input", "label": "build", "press": "KeyB", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "scan-window", "waitTicks": 330, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "scanWindowFrames", "equals": 300, "changed": true },
      { "id": "state", "path": "scanWindowValid", "equals": true, "changed": true },
      { "id": "state", "path": "scanWindowScans", "gte": 10, "changed": true }
    ]
  }
}
