{
  "name": "adventure-talk",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-the-stair",
      "press": "KeyW",
      "holdTicks": 150,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-the-keeper",
      "press": "KeyD",
      "holdTicks": 200,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-the-keeper",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "talk",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "speaking",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "next-line",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "last-line",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "close",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "done",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minDistance": 10
    },
    "resources": [
      {
        "id": "state",
        "path": "prompt",
        "atSteps": [
          {
            "label": "at-the-keeper",
            "equals": "Talk to Mira"
          }
        ]
      },
      {
        "id": "state",
        "path": "stage",
        "atSteps": [
          {
            "label": "at-the-keeper",
            "equals": "meet"
          },
          {
            "label": "speaking",
            "equals": "seek"
          }
        ]
      },
      {
        "id": "state",
        "path": "dialogMore",
        "atSteps": [
          {
            "label": "speaking",
            "equals": true
          },
          {
            "label": "done",
            "equals": false
          }
        ]
      },
      {
        "id": "state",
        "path": "dialog",
        "atSteps": [
          {
            "label": "done",
            "equals": ""
          }
        ]
      }
    ],
    "audio": [
      {
        "cue": "talk",
        "minPlays": 3
      }
    ]
  }
}
