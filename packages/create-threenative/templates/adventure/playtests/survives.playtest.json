{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-forward",
      "press": "ArrowUp",
      "holdTicks": 90,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-walk",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minDistance": 2
    },
    "resources": [
      {
        "id": "state",
        "path": "gems",
        "gte": 1
      },
      {
        "id": "state",
        "path": "gems",
        "atSteps": [
          {
            "label": "settle",
            "equals": 0
          }
        ]
      }
    ],
    "audio": [
      {
        "cue": "gem",
        "minPlays": 1
      },
      {
        "cue": "step",
        "minPlays": 4
      }
    ]
  }
}
