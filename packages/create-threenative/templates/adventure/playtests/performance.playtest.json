{
  "name": "forest-performance",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "height": 1080,
    "width": 1920
  },
  "warmupFrames": 60,
  "steps": [
    {
      "kind": "input",
      "label": "walk",
      "press": "ArrowUp",
      "holdTicks": 120,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 600,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "performance": {
      "maxDrawCalls": 450,
      "maxFrameMsP95": 33,
      "maxTriangles": 1400000,
      "minFps": 30
    },
    "renderChain": {
      "tier": "high"
    }
  }
}
