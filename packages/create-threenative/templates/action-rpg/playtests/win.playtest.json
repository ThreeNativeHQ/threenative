{
  "name": "action-rpg-boss-win",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "cross-rooms", "press": "KeyD", "holdTicks": 285, "release": true },
    { "kind": "input", "label": "surge", "press": "KeyE", "holdTicks": 1, "release": true },
    { "kind": "input", "label": "boss-hit-1", "press": "KeyF", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "boss-ready-2", "waitTicks": 8, "release": true },
    { "kind": "input", "label": "boss-hit-2", "press": "KeyF", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "boss-ready-3", "waitTicks": 8, "release": true },
    { "kind": "input", "label": "boss-hit-3", "press": "KeyF", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "boss-ready-4", "waitTicks": 8, "release": true },
    { "kind": "input", "label": "boss-hit-4", "press": "KeyF", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "win-settled", "waitTicks": 30, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "gameWon", "equals": 1, "changed": true },
      { "id": "GameState", "path": "phase", "equals": "won", "changed": true },
      { "id": "GameState", "path": "enemiesDefeated", "gte": 1, "changed": true }
    ],
    "signals": [{ "name": "defeated", "entity": "boss", "minCount": 1, "atStep": "boss-hit-3" }],
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
