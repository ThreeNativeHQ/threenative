{
  "name": "action-rpg-fail-condition",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "forced-death", "press": "KeyX", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "failed", "waitTicks": 8, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "gameOver", "equals": 1, "changed": true },
      { "id": "state", "path": "phase", "equals": "lost", "changed": true },
      { "id": "state", "path": "health", "equals": 0, "changed": true }
    ],
    "signals": [{ "name": "died", "entity": "player", "minCount": 1, "atStep": "forced-death" }]
  }
}
