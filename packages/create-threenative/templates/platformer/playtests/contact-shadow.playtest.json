{
  "name": "contact-shadow",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": { "screenshots": "before-after" },
  "steps": [{ "kind": "wait", "label": "fox-standing", "waitTicks": 120, "release": true }],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "renderChain": { "stages": { "includes": ["contactShadows"] } },
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.9,
          "maxDarkPixelRatio": 0.4
        }
      }
    ]
  }
}
