{
  "name": "platformer-stomp-rise",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "enemy-contact",
      "press": "ArrowRight",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "rise-after-contact",
      "press": "Space",
      "holdTicks": 4,
      "release": true
    },
    { "kind": "wait", "label": "damage-settled", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "hearts", "equals": 2, "changed": true },
      { "id": "GameState", "path": "defeated", "equals": 0, "allowTrivial": true }
    ],
    "tags": [{ "tag": "patrol", "count": 1 }]
  }
}
