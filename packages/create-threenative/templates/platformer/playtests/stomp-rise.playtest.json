{
  "name": "platformer-stomp-rise",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 26, "release": true },
    { "kind": "input", "press": "ArrowRight", "holdTicks": 3, "release": false },
    { "kind": "input", "press": "Space", "holdTicks": 4, "release": true },
    { "kind": "wait", "waitTicks": 34, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "GameState", "path": "hearts", "equals": 2, "changed": true },
      { "id": "GameState", "path": "defeated", "equals": 0, "allowTrivial": true }
    ],
    "tags": [{ "tag": "patrol", "count": 1 }]
  }
}
