{
  "name": "platformer-touch-controls-web",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": { "screenshots": "after" },
  "steps": [
    {
      "kind": "input",
      "label": "movement-anchor",
      "pointers": [{ "id": 7, "x": 0.18, "y": 0.75 }],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "simultaneous-move-and-jump",
      "pointers": [{ "id": 7, "x": 0.3, "y": 0.75 }, { "id": 3, "x": 0.922, "y": 0.861 }],
      "holdTicks": 45,
      "release": true
    },
    { "kind": "wait", "label": "settled", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": { "entity": "player", "minDistance": 0.5 },
    "resources": [
      { "id": "state", "path": "jumps", "gte": 1, "changed": true },
      { "id": "state", "path": "playerX", "gte": 0.05, "changed": true }
    ],
    "visibility": [
      {
        "entity": "touch-controls",
        "present": true,
        "allowTrivial": "Touch-primary lanes keep the authored controls visible while state assertions prove they are live."
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
