{
  "name": "sailing-touch-controls",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "movement-anchor",
      "pointers": [{ "id": 7, "x": 0.18, "y": 0.75 }],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "sail-forward",
      "pointers": [{ "id": 7, "x": 0.18, "y": 0.55 }],
      "holdTicks": 90,
      "release": true
    },
    { "kind": "wait", "label": "settled", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": { "entity": "player", "minDistance": 0.1 },
    "visibility": [
      {
        "entity": "touch-controls",
        "present": true,
        "allowTrivial": "Touch-primary sailing keeps the authored movement surface visible while movement proves its binding."
      }
    ]
  }
}
