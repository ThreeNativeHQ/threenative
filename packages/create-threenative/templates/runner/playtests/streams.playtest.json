{
  "name": "streams",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 40,
  "subject": "player",
  "steps": [
    { "kind": "wait", "label": "run-a-while", "waitTicks": 300, "release": true },
    { "kind": "input", "label": "lane-left", "press": "KeyA", "holdTicks": 6, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 60, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "chunks",
        "gte": 7
      },
      {
        "changed": true,
        "id": "GameState",
        "path": "distance"
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 20,
      "minAxisDelta": { "axis": "-z", "min": 20 }
    }
  }
}
