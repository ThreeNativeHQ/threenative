{
  "name": "rain-browser-controls-and-capture",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 390, "height": 844 },
  "warmupFrames": 60,
  "artifacts": { "screenshots": "both" },
  "steps": [
    { "kind": "input", "press": "KeyL", "label": "strike", "release": true, "waitTicks": 2 },
    { "kind": "input", "press": "KeyX", "label": "safe", "release": true, "waitTicks": 20 },
    { "kind": "input", "press": "KeyH", "label": "hidden", "release": true, "waitTicks": 20 },
    { "kind": "input", "press": "KeyP", "label": "capture", "release": true, "waitTicks": 40 },
    { "kind": "input", "press": "Space", "label": "paused", "release": true, "waitTicks": 20 }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "status",
        "atSteps": [
          { "equals": "flashing", "label": "strike" },
          { "equals": "flashing", "label": "safe" },
          { "equals": "paused", "label": "paused" }
        ],
        "equals": "paused"
      },
      {
        "id": "state",
        "path": "safe",
        "atSteps": [
          { "equals": false, "label": "strike" },
          { "equals": true, "label": "safe" }
        ],
        "equals": true
      },
      { "id": "state", "path": "uiHidden", "atSteps": [{ "equals": true, "label": "hidden" }], "equals": true },
      { "id": "state", "path": "quality", "equals": "performance" },
      { "id": "state", "path": "frame", "gte": 30 },
      { "id": "state", "path": "dropCount", "gte": 1 }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 390,
          "height": 844,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}