{
  "name": "rain-loading-curtain-lifts-on-the-storm",
  "schemaVersion": 1,
  "target": "web",
  "awaitStartup": false,
  "viewport": {
    "width": 1024,
    "height": 768
  },
  "warmupFrames": 1,
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "wait",
      "waitTicks": 1,
      "screenshot": "curtain",
      "release": true
    },
    {
      "waitForResource": {
        "id": "state",
        "path": "loading.ready",
        "equals": true
      },
      "timeoutMs": 60000,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 90,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "loading.ready",
        "equals": true
      },
      {
        "id": "state",
        "path": "loading.progress",
        "changed": true
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.5
        }
      }
    ]
  }
}
