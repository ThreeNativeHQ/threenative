{
  "name": "__PROJECT_NAME__",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "test:native": "pnpm build:desktop && node node_modules/@threenative/runtime-native/scripts/verify-starter-desktop.mjs",
    "pretest": "playwright install chromium",
    "test": "vite build && threenative-playtest --scenario playtests/survives.playtest.json --url http://127.0.0.1:4173 --server-command \"pnpm dev --host 127.0.0.1 --port 4173 --strictPort\" && threenative-playtest --scenario playtests/shooter.playtest.json --url http://127.0.0.1:4173 --server-command \"pnpm dev --host 127.0.0.1 --port 4173 --strictPort\" --browser-recipe webgpu && threenative-playtest --scenario playtests/fail.playtest.json --url http://127.0.0.1:4173 --server-command \"pnpm dev --host 127.0.0.1 --port 4173 --strictPort\" --browser-recipe webgpu",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@threenative/core": "0.2.0",
    "@threenative/physics": "0.2.0",
    "@threenative/ui": "0.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "@threenative/playtest": "0.2.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "playwright": "1.62.1",
    "create-threenative": "0.2.0",
    "tailwindcss": "4.3.3",
    "threenative-asset-mcp": "0.4.0",
    "threenative-sculpt-mcp": "0.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@threenative/runtime-native"]
  }
}
