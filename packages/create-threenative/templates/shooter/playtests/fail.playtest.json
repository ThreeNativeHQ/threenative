{
  "name": "shooter-fail-condition",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "first-hit", "press": "KeyX", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "first-respawn", "waitTicks": 45, "release": true },
    { "kind": "input", "label": "second-hit", "press": "KeyX", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "second-respawn", "waitTicks": 45, "release": true },
    { "kind": "input", "label": "third-hit", "press": "KeyX", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "failed", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noRuntimeDiagnostics": false,
      "runtimeDiagnosticsOptOutReason": "Headless Linux Chromium emits the known WebGPU buffer diagnostic; fail-condition assertions remain authoritative.",
      "runtimeReady": true
    },
    "resources": [
      { "id": "state", "path": "deaths", "equals": 3, "changed": true },
      { "id": "state", "path": "lives", "equals": 0, "changed": true },
      { "id": "state", "path": "gameOver", "equals": 1, "changed": true },
      { "id": "state", "path": "phase", "textIncludes": "lost", "changed": true }
    ],
    "signals": [{ "name": "died", "entity": "player", "minCount": 3 }]
  }
}
