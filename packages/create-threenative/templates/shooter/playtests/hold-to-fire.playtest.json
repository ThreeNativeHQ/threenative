{
  "name": "hold-to-fire",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "trigger-held",
      "press": "Space",
      "holdTicks": 90,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "shots",
        "gte": 8,
        "allowTrivial": "shots is zero until the trigger is pulled, so an interrupted hold cannot reach eight"
      }
    ],
    "movement": {
      "entity": "player",
      "maxDistance": 0.01
    }
  }
}
