{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 60,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "move", "press": "ArrowUp", "holdTicks": 60, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "allowTrivial": "GroundSnap settles the player before this movement observation; the finite near-zero clearance is the generated call-site proof.",
        "component": "groundClearance",
        "entity": "player",
        "lte": 0.01
      },
      {
        "allowTrivial": "The shooter rifle has an authored non-unit size; this retained factor proves normaliseToMetres ran in the generated player.",
        "component": "normaliseFactor",
        "entity": "player",
        "gte": 1.01
      },
      {
        "allowTrivial": "Weapon attachment is construction-time; the resolved RightHand parent proves attachToBone ran in the generated player.",
        "component": "weaponBone",
        "entity": "player",
        "equals": "RightHand"
      }
    ],
    "movement": { "entity": "player", "minDistance": 0.5 },
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
