{
  "name": "input-control",
  "target": "web",
  "schemaVersion": 1,
  "parity": {
    "targets": ["web", "desktop"]
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 60,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "no-input-control",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "wake-pointer",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.5,
        "buttons": 1
      },
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "wake-settle",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "reset-heading",
      "press": "Enter",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "reset-settle",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "aim-down",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.5,
        "buttons": 2
      },
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "wait",
      "label": "aim-settle",
      "waitTicks": 6,
      "release": true
    },
    {
      "kind": "input",
      "label": "release-buttons",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.5,
        "buttons": 0
      },
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "release-settle",
      "waitTicks": 8,
      "release": true
    },
    {
      "kind": "input",
      "label": "aim-key",
      "press": "KeyF",
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "wait",
      "label": "aim-key-settle",
      "waitTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "fire-while-aiming",
      "pointerPosition": {
        "x": 0.5,
        "y": 0.5,
        "buttons": 1
      },
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "fire-settle",
      "waitTicks": 8,
      "release": true
    },
    {
      "kind": "input",
      "label": "look-right",
      "pointerPosition": {
        "x": 0.75,
        "y": 0.5
      },
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "wait",
      "label": "look-right-settle",
      "waitTicks": 8,
      "release": true,
      "screenshot": "input-look-right"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": false,
      "consoleErrorsOptOutReason": "The desktop host logs one window-branding notice at error level for any project without an embedded icon; it is host noise, not game behaviour.",
      "noNetworkErrors": false,
      "networkErrorsOptOutReason": "Desktop and Android device transport have no CDP network observer; this scenario runs on both targets, so the browser-only network policy is opted out here and covered by the web-only template scenarios.",
      "noRuntimeDiagnostics": false,
      "runtimeDiagnosticsOptOutReason": "Headless Linux Chromium emits the known WebGPU buffer diagnostic; gameplay and visibility assertions remain authoritative.",
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "shots",
        "atSteps": [
          {
            "label": "fire-settle",
            "equals": 1
          }
        ],
        "allowTrivial": "shots is zero until a round leaves the barrel, so the initial state cannot satisfy this"
      },
      {
        "id": "state",
        "path": "ammo",
        "atSteps": [
          {
            "label": "fire-settle",
            "equals": 29
          }
        ],
        "allowTrivial": "the magazine starts full, so a resting 30 cannot satisfy this"
      },
      {
        "id": "state",
        "path": "aiming",
        "atSteps": [
          {
            "label": "aim-settle",
            "equals": true
          },
          {
            "label": "release-settle",
            "equals": false
          },
          {
            "label": "aim-key-settle",
            "equals": true
          }
        ]
      },
      {
        "id": "state",
        "path": "playerYaw",
        "gte": -0.5,
        "lte": -0.2
      }
    ],
    "components": [
      {
        "entity": "rifle",
        "component": "barrelAxisErrorDeg",
        "lte": 0.5
      },
      {
        "entity": "rifle",
        "component": "opticScreen",
        "path": "x",
        "gte": 0.48,
        "lte": 0.52
      }
    ]
  }
}
