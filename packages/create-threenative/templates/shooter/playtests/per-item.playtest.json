{
  "name": "per-item-mechanisms",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 60,
  "subject": "player",
  "steps": [
    { "kind": "wait", "label": "sprite-baseline", "waitTicks": 1, "release": true },
    {
      "kind": "input",
      "label": "hit",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "shake-and-animation",
      "waitTicks": 12,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": false,
      "runtimeDiagnosticsOptOutReason": "Headless Linux Chromium emits the known WebGPU buffer diagnostic; gameplay and mechanism assertions remain authoritative.",
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "cameraShakes",
        "atSteps": [{ "label": "hit", "equals": 1 }],
        "changed": true
      },
      {
        "id": "state",
        "path": "nameplateFacingCamera",
        "atSteps": [{ "label": "sprite-baseline", "equals": 1 }]
      },
      { "id": "state", "path": "pickupFrameChanges", "changed": true }
    ],
    "signals": [{ "name": "hit", "entity": "player", "minCount": 1, "atStep": "hit" }],
    "visibility": [
      {
        "allowTrivial": "The player's own capsule is invisible in first person; the viewmodel is what the player sees of themselves, so this row measures the weapon in frame.",
        "entity": "viewmodel",
        "minProjectedPixels": 400
      }
    ],
    "movement": {
      "entity": "camera.main",
      "minDistance": 0.001,
      "rotationChanged": true
    }
  }
}
