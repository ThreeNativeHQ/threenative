{
  "name": "enemy-material-is-not-shared",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "enemy",
  "setup": {
    "entities": [
      {
        "entity": "player",
        "position": [-4.5, 0.89, -5.0]
      },
      {
        "entity": "enemy-frozen",
        "position": [-4.5, 0, -6.8]
      }
    ]
  },
  "steps": [
    {
      "kind": "input",
      "label": "kill-shot",
      "press": "Space",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "full-respawn-fade-cycle",
      "waitTicks": 350,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "enemy",
        "component": "materialOpacityFloor",
        "lte": 0.9,
        "allowTrivial": "the killed soldier must actually have faded for this scenario to exercise the bug path at all"
      },
      {
        "entity": "enemy-1",
        "component": "materialOpacityFloor",
        "equals": 1,
        "allowTrivial": "a soldier who never died and shares no cloned material with the one fading must never dip — before `ownMaterial`, every soldier's mesh pointed at the same MeshStandardMaterial the GLTF parsed once, so soldier 0's respawn fade wrote soldier 1's opacity too"
      }
    ]
  }
}
