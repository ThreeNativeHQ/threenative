{
  "name": "rts-ai-attack",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "selection",
  "steps": [
    { "kind": "wait", "label": "settle", "waitTicks": 60, "release": true },
    {
      "label": "contact",
      "release": true,
      "timeoutMs": 120000,
      "waitForResource": { "id": "state", "path": "supplyUsed", "lte": 22 }
    },
    { "kind": "wait", "label": "after", "waitTicks": 60, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [{ "id": "state", "path": "supplyUsed", "changed": true }],
    "renderChain": { "tier": "high" }
  }
}
