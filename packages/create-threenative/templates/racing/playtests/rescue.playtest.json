{
  "name": "racing-rescue-transform",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "rescue",
      "press": ["ArrowUp", "ArrowRight"],
      "holdTicks": 150,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "rescues", "gte": 1, "changed": true },
      { "id": "state", "path": "lastOnRoad", "changed": true },
      { "id": "state", "path": "rescueHeading", "changed": true },
      { "id": "state", "path": "rescuePositionError", "equals": 0, "changed": true },
      { "id": "state", "path": "rescueHeadingError", "equals": 0, "changed": true }
    ],
    "visibility": [
      {
        "allowTrivial": "The racing scene begins with the player visible and in frame; this held visibility row accompanies the rescue assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
