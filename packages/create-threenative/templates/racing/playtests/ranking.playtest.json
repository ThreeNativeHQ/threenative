{
  "name": "racing-route-ranking",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 0,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "lap-aware-baseline",
      "waitTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "advance-on-route",
      "press": "ArrowUp",
      "holdTicks": 30,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      {
        "id": "GameState",
        "path": "sameDistanceRanking",
        "atSteps": [
          { "label": "lap-aware-baseline", "equals": "lap-ahead" },
          { "label": "advance-on-route", "equals": "lap-ahead" }
        ]
      },
      { "id": "GameState", "path": "trackProgress", "gte": 142, "changed": true }
    ]
  }
}
