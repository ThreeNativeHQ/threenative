{
  "name": "neural-rendering-fixture",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 512,
    "height": 512
  },
  "warmupFrames": 30,
  "steps": [
    {
      "kind": "input",
      "label": "request snapshot proof",
      "press": "KeyC",
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "two GPU-verified snapshots",
      "waitForResource": {
        "id": "state",
        "path": "proofCount",
        "equals": 2
      },
      "timeoutMs": 30000,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "proofPassed",
        "equals": true,
        "changed": true
      },
      {
        "id": "state",
        "path": "proofCount",
        "equals": 2,
        "changed": true
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 512,
          "height": 512,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
