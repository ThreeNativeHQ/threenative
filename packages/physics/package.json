{
  "name": "@threenative/physics",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Rapier physics bindings for ThreeNative games.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "threenative-native": "./dist/native/index.js",
      "import": "./dist/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "threenative-native": "./dist/native/proof.js",
      "import": "./dist/proof.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": ["./src/web.ts", "./src/native.ts"],
  "dependencies": {
    "@dimforge/rapier3d-compat": "catalog:",
    "recast-navigation": "catalog:"
  },
  "peerDependencies": {
    "@threenative/core": ">=0.1.0 <0.2.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build"
  },
  "devDependencies": {
    "@types/three": "0.185.3",
    "@threenative/core": "workspace:*",
    "publint": "0.3.22",
    "three": "catalog:",
    "tsup": "8.5.1",
    "typescript": "catalog:"
  }
}
