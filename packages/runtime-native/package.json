{
  "name": "@threenative/runtime-native",
  "version": "0.3.0",
  "description": "ThreeNative-owned native host for desktop, Android, and iOS",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "android/README.md",
    "android/app/build.gradle.kts",
    "android/app/proguard-rules.pro",
    "android/app/src/main/AndroidManifest.xml",
    "android/app/src/main/java",
    "android/app/src/main/res",
    "android/build.gradle.kts",
    "android/gradle.properties",
    "android/gradle/wrapper/gradle-wrapper.jar",
    "android/gradle/wrapper/gradle-wrapper.properties",
    "android/gradlew",
    "android/settings.gradle.kts",
    "scripts/bundle.mjs",
    "scripts/install-prebuilt.mjs",
    "scripts/package-android.mjs",
    "scripts/package-desktop.mjs",
    "scripts/package-ios.mjs",
    "scripts/physical-device-evidence.mjs",
    "scripts/production-evidence.mjs",
    "scripts/profile-production.mjs",
    "scripts/qualify-physical-mobile.mjs",
    "scripts/verify-starter-desktop.mjs"
  ],
  "scripts": {
    "deps:download": "node scripts/download-deps.mjs",
    "native:build": "node scripts/download-deps.mjs && node scripts/native-build.mjs",
    "native:physics:cross": "node scripts/build-native-physics.mjs",
    "native:physics:measure": "node scripts/measure-physics-divergence.mjs",
    "native:physics:parity": "pnpm --dir ../.. exec vitest run packages/physics/__tests__/parity.spec.ts && cargo test --manifest-path native/physics/Cargo.toml --test parity -- --nocapture",
    "native:physics:parity:device": "node scripts/verify-android-physics-parity.mjs",
    "native:qualify:physical": "node scripts/qualify-physical-mobile.mjs",
    "native:verify:desktop": "node scripts/verify-desktop-core.mjs && node scripts/verify-desktop-physics.mjs",
    "native:verify:android:multitouch": "pnpm --dir ../playtest build && node scripts/verify-android-multitouch.mjs",
    "profile:production": "node scripts/profile-production.mjs",
    "parity": "node conformance/run-conformance.mjs",
    "install": "node scripts/install-prebuilt.mjs",
    "test": "vitest run --config vitest.config.ts && pnpm native:physics:parity && publint --strict"
  },
  "devDependencies": {
    "@threenative/playtest": "workspace:*",
    "esbuild": "catalog:",
    "publint": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "pngjs": "catalog:"
  }
}
