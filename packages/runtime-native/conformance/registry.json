{
  "schemaVersion": "0.1.0",
  "threeVersion": "0.185.1",
  "policy": {
    "renderer": "three/webgpu WebGPURenderer",
    "noCustomCppRenderer": true,
    "gltf": "JavaScript Three.js GLTFLoader only"
  },
  "exclusions": [
    {
      "id": "react-dom-tailwind-hud",
      "title": "React DOM and Tailwind HUD",
      "category": "ui",
      "status": "excluded",
      "reason": "The native host provides compatibility stubs, not a DOM or CSS layout engine.",
      "owner": "PRD-055"
    },
    {
      "id": "rapier-wasm-mobile",
      "title": "Rapier WASM on mobile",
      "category": "physics",
      "status": "excluded",
      "reason": "Android QuickJS and iOS JavaScriptCore do not execute the web Rapier WASM backend.",
      "owner": "PRD-046"
    },
    {
      "id": "recast-wasm-mobile",
      "title": "Recast WASM on mobile",
      "category": "navigation",
      "status": "excluded",
      "reason": "The navigation package is browser-only; portable templates use source-local steering.",
      "owner": "PRD-052"
    },
    {
      "id": "raw-glsl-shader-material-webgpu",
      "title": "raw GLSL ShaderMaterial under WebGPU",
      "category": "rendering",
      "status": "excluded",
      "reason": "Raw GLSL ShaderMaterial fails under Three.js WebGPURenderer on every target.",
      "owner": "PRD-054"
    },
    {
      "id": "desktop-multitouch-input",
      "title": "Desktop multitouch input injection",
      "category": "input",
      "status": "excluded",
      "reason": "The injector exists and works to the kernel boundary (conformance/desktop-touch.mjs, tools/uinput_touch_device.c): it creates a virtual touchscreen unprivileged, the kernel enumerates it with INPUT_PROP_DIRECT and the four ABS_MT_* axes, and contacts are aimed at the window's real rectangle. Nothing downstream reads it on this host. /dev/input/event* is root:input 0660 and this user is not in the input group, so SDL's evdev path cannot open it; and the lane runs under Xvfb, which has no evdev backend at all. This is a host and display-server constraint, not a missing capability. Evidence: docs/verification/desktop-multitouch-2026-08-15-r2.md.",
      "owner": "PRD-077",
      "expires": "2026-12-31",
      "target": "desktop",
      "row": "90-multitouch-input"
    }
  ],
