<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan/GPU features -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />

    <!-- Optional: Game controller support -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <!-- Network permission for fetch() API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreeNative"
        android:hasCode="true">
        <!-- package-android.mjs writes the project adaptive launcher icon here. -->

        <!-- Main SDL Activity -->
        <!-- configChanges must cover every axis a mid-play environment change can hit. An
             uncovered axis recreates the activity in-process, and SDL then exits the whole
             process (nativeAllowRecreateActivity defaults false and is deliberately left
             unhinted — PRD-222 Phase 1), so the player's return from split-screen or a
             font-scale change replays the entire loading sequence. smallestScreenSize covers
             split-screen/freeform entry; the rest cover user-facing display settings. -->
        <activity
            android:name="com.threenative.runtime.MystralActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode"
            android:exported="true"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="SDL_ENV.MYSTRAL_RUNTIME_VERSION"
                android:value="0.1.0" />
        </activity>
    </application>

</manifest>
