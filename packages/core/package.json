{
  "name": "@threenative/core",
  "version": "0.2.0",
  "description": "The small vanilla Three.js game runtime foundation.",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playtest": {
      "types": "./dist/playtest.d.ts",
      "import": "./dist/playtest.js"
    },
    "./hot": {
      "types": "./dist/hot.d.ts",
      "import": "./dist/hot.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "three": "catalog:",
    "three-mesh-bvh": "catalog:",
    "zustand": "catalog:"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build"
  },
  "devDependencies": {
    "@types/three": "0.185.3",
    "@threenative/playtest": "workspace:*",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:"
  }
}
