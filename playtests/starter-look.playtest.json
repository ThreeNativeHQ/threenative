{
  "acceptanceId": "PRD-011-starter-look",
  "artifacts": {
    "screenshots": "after"
  },
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true
    },
    "resources": [
      {
        "equals": "playing",
        "id": "state",
        "path": "screen"
      }
    ]
  },
  "inputDelivery": "deterministic",
  "name": "starter-look",
  "schemaVersion": 1,
  "steps": [
    {
      "kind": "wait",
      "label": "menu-is-up",
      "release": true,
      "waitTicks": 20
    },
    {
      "at": {
        "x": 640,
        "y": 365
      },
      "kind": "click",
      "label": "focus-name-field"
    },
    {
      "holdTicks": 1,
      "kind": "input",
      "label": "type-a",
      "press": "a",
      "release": true
    },
    {
      "holdTicks": 1,
      "kind": "input",
      "label": "type-x",
      "press": "x",
      "release": true
    },
    {
      "holdTicks": 1,
      "kind": "input",
      "label": "type-o",
      "press": "o",
      "release": true
    },
    {
      "at": {
        "x": 640,
        "y": 428
      },
      "kind": "click",
      "label": "start-game"
    },
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "release": true,
      "waitTicks": 90
    },
    {
      "label": "settled-look",
      "screenshot": "starter-look",
      "waitFrames": 60
    }
  ],
  "target": "web",
  "viewport": {
    "height": 720,
    "width": 1280
  },
  "warmupFrames": 30
}
