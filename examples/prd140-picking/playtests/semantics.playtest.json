{
  "name": "prd152-semantic-stress",
  "schemaVersion": 1,
  "subject": "A game that never opts into batching keeps its graph, its picking and its mutations",
  "target": "web",
  "artifacts": { "screenshots": false },
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "steps": [
    { "kind": "wait", "label": "settle-mutate-and-assert", "waitTicks": 1400, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      { "id": "GameState", "path": "framesRun", "gte": 1200, "changed": true },
      { "id": "GameState", "path": "graphIntact", "equals": 1, "changed": true },
      { "id": "GameState", "path": "pickedTarget", "equals": 1, "changed": true },
      { "id": "GameState", "path": "pickedUnannotated", "equals": 1, "changed": true },
      { "id": "GameState", "path": "semanticsIntact", "equals": 1, "changed": true },
      { "id": "GameState", "path": "hiddenIntact", "equals": 1, "changed": true },
      { "id": "GameState", "path": "lateMutationApplied", "equals": 1, "changed": true },
      { "id": "GameState", "path": "overlayRides", "equals": 1, "changed": true }
    ]
  }
}
