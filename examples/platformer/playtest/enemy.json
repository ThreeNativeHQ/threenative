{
  "name": "platformer-enemy",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "fox",
  "steps": [
    {
      "kind": "input",
      "press": "ArrowRight",
      "holdTicks": 120,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "hearts",
        "changed": true
      }
    ]
  }
}