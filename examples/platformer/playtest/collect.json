{
  "name": "platformer-collect",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "fox",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 200, "release": true },
    { "kind": "wait", "waitTicks": 20, "release": false }
  ],
  "assert": {
    "contacts": [{ "entity": "fox", "minCount": 1, "with": "coin.3" }],
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "hud": [{ "equals": 3, "id": "coins" }],
    "tags": [{ "count": 14, "tag": "coin" }]
  }
}
