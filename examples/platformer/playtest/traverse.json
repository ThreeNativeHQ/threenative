{
  "name": "platformer-traverse",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "fox",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 200, "release": true },
    { "kind": "wait", "waitTicks": 20, "release": false }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": {
      "entity": "fox",
      "minDistance": 12,
      "reachesPositionWithin": { "maxDistance": 1.5, "position": [17.5, 0.55, 0] }
    }
  }
}
