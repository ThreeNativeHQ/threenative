{
  "name": "platformer-run-camera",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "fox",
  "steps": [{ "kind": "input", "press": "ArrowRight", "holdTicks": 60, "release": false }],
  "assert": {
    "animation": [{ "entity": "fox", "clip": "run", "advancedFrames": 10 }],
    "camera": { "entity": "camera.main", "follows": "fox", "targetInViewport": true, "within": 14 },
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": { "entity": "fox", "minDistance": 6 }
  }
}
