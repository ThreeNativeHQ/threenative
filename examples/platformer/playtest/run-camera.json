{
  "name": "platformer-run-camera",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "fox",
  "steps": [
    {
      "kind": "input",
      "press": "ArrowRight",
      "holdTicks": 45,
      "release": false
    },
    {
      "kind": "wait",
      "waitTicks": 8,
      "release": false
    }
  ],
  "assert": {
    "animation": [
      {
        "entity": "fox",
        "clip": "run",
        "advancedFrames": 10
      }
    ],
    "camera": {
      "entity": "camera.main",
      "follows": "fox",
      "targetInViewport": true
    },
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "fox",
      "minAxisDelta": {
        "axis": "+x",
        "min": 2
      }
    },
    "states": [
      {
        "entity": "fox",
        "equals": "run"
      }
    ]
  }
}