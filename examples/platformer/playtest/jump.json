{
  "name": "platformer-jump",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "fox",
  "steps": [{ "kind": "input", "press": "Space", "holdTicks": 10, "release": false }],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": { "entity": "fox", "minAxisDelta": { "axis": "+y", "min": 1.5 } },
    "states": [{ "entity": "fox", "equals": "jump" }]
  }
}
