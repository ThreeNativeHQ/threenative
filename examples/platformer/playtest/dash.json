{
  "name": "platformer-dash",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 12,
  "subject": "fox",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 6, "release": true },
    { "kind": "input", "press": "ShiftLeft", "holdTicks": 30, "release": true },
    { "kind": "input", "press": "ShiftLeft", "holdTicks": 2, "release": false }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": { "entity": "fox", "minAxisDelta": { "axis": "+x", "min": 5.5 } },
    "states": [{ "entity": "fox", "equals": "dash" }]
  }
}
