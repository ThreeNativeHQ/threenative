{
  "schemaVersion": 1,
  "name": "wasm-engine-renderer",
  "target": "web",
  "subject": "wasm-renderer",
  "viewport": { "width": 640, "height": 360 },
  "warmupFrames": 10,
  "artifacts": { "screenshots": true },
  "steps": [{ "kind": "wait", "label": "rendered", "waitTicks": 30 }],
  "assert": {
    "components": [
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "error",
        "equals": "",
        "allowTrivial": "The page reports its own failure here."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "software",
        "equals": false,
        "allowTrivial": "The engine's own adapter is hardware, never SwiftShader."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "refusal",
        "equals": "TN_NATIVE_RENDERER_STATE: toneMapping 5.000000",
        "allowTrivial": "Set once before the first frame; the engine names the tone mapping it refused."
      },
      { "entity": "wasm-renderer", "component": "probe", "path": "frames", "gte": 30 },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "steadyCompiles",
        "equals": 0,
        "allowTrivial": "A steady frame compiles no pipeline; -1 means frame 10 never drew."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "steadyTextKeys",
        "equals": 0,
        "allowTrivial": "Every pipeline lookup after warm-up hits the id cache (the wasm32 hash once missed every one)."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "steadyBindGroups",
        "equals": 0,
        "allowTrivial": "A steady frame creates no bind group."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "steadyGraphKeys",
        "equals": 0,
        "allowTrivial": "A steady frame serializes no TSL graph key."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "steadyPrograms",
        "equals": 0,
        "allowTrivial": "A steady frame builds no program."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "draws",
        "gte": 1,
        "allowTrivial": "ready() resolves after the first engine frame, so the draw count holds from the first sample."
      },
      {
        "entity": "wasm-renderer",
        "component": "probe",
        "path": "triangles",
        "gte": 24,
        "allowTrivial": "ready() resolves after the first engine frame; two boxes of 12 triangles plus the output pass."
      }
    ],
    "visual": [
      {
        "region": { "x": 120, "y": 80, "width": 400, "height": 200, "minNonblankPixelRatio": 0.2 }
      }
    ]
  }
}
