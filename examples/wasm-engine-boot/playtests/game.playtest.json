{
  "schemaVersion": 1,
  "name": "wasm-engine-game",
  "target": "web",
  "viewport": { "width": 640, "height": 360 },
  "warmupFrames": 10,
  "artifacts": { "screenshots": true },
  "steps": [{ "kind": "wait", "label": "running", "waitTicks": 30 }],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [{ "id": "state", "path": "frames", "gte": 30, "changed": true }],
    "visual": [
      {
        "region": { "x": 220, "y": 100, "width": 200, "height": 160, "minNonblankPixelRatio": 0.2 }
      }
    ]
  }
}
