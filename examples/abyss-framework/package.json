{
  "name": "abyss-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "threenative build --target android",
    "playtest:loading-leak": "node ../../packages/playtest/dist/runner/cli.js playtests/loading-leak.playtest.json --url 'http://127.0.0.1:5180/?loading-leak' --server-command 'pnpm dev --host 127.0.0.1 --port 5180 --strictPort' --browser-recipe webgpu --headed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@threenative/core": "workspace:*",
    "@threenative/physics": "workspace:*",
    "@threenative/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "catalog:",
    "create-threenative": "workspace:*",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "workspace:*"
  }
}
