{
  "schemaVersion": 1,
  "name": "vq-volumetric-fog-lifecycle",
  "target": "web",
  "viewport": { "width": 640, "height": 400 },
  "warmupFrames": 60,
  "steps": [
    { "press": ["KeyI"], "holdTicks": 1, "release": true },
    { "kind": "wait", "waitFrames": 20 },
    { "press": ["KeyO"], "holdTicks": 1, "release": true },
    { "kind": "wait", "waitFrames": 20 },
    { "press": ["KeyF"], "holdTicks": 1, "release": true },
    { "kind": "wait", "waitFrames": 20 },
    { "press": ["KeyC"], "holdTicks": 1, "release": true },
    { "kind": "wait", "waitFrames": 60 }
  ],
  "assert": {
    "components": [
      {
        "entity": "fog",
        "component": "ready",
        "equals": true,
        "allowTrivial": "The graph must be ready after repeated reconstruction."
      },
      {
        "entity": "fog",
        "component": "mode",
        "equals": "fog",
        "allowTrivial": "The fixture returns to the initial authored medium."
      },
      {
        "entity": "fog",
        "component": "targets",
        "equals": 1,
        "allowTrivial": "Exactly the current fog RTT remains after replacement."
      },
      { "entity": "fog", "component": "disposedGraphs", "gte": 4, "changed": true }
    ],
    "diagnostics": { "noConsoleErrors": true, "noRuntimeDiagnostics": true, "runtimeReady": true },
    "visual": [
      { "region": { "x": 0, "y": 0, "width": 640, "height": 400, "minNonblankPixelRatio": 0.05 } }
    ]
  },
  "artifacts": { "screenshots": "after", "console": true, "runtimeTrace": true }
}
