{
  "name": "skinned-crowd-one-palette-draw",
  "schemaVersion": 1,
  "subject": "64 animated rigs the game wrote as plain SkinnedMesh objects draw as one palette draw per pass, and keep moving",
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 90,
  "artifacts": { "screenshots": "before-after" },
  "steps": [
    { "kind": "wait", "label": "settled", "waitTicks": 30, "release": true },
    { "kind": "wait", "label": "swayed", "waitTicks": 45, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "performance": { "maxDrawCalls": 8 },
    "sceneNodes": [
      { "select": { "type": "SkinnedMesh" }, "minCount": 64, "visible": true, "inFrustum": true },
      { "select": { "name": "ground" }, "visible": true, "minTriangles": 2 }
    ],
    "visual": [
      { "frameDiff": { "minChangedPixelRatio": 0.002 } },
      {
        "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.3 }
      }
    ]
  }
}
