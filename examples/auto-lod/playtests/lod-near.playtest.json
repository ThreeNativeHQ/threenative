{
  "name": "lod-near",
  "schemaVersion": 1,
  "subject": "the near camera selects LOD0 for the model",
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 90,
  "artifacts": { "screenshots": true, "console": true },
  "steps": [
    {
      "kind": "input",
      "label": "close",
      "press": "Space",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settled",
      "waitTicks": 120,
      "release": true,
      "screenshot": "near"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "sceneNodes": [
      {
        "select": { "nameContains": "hull-mesh" },
        "minCount": 1,
        "minTriangles": 8000,
        "visible": true
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.05
        }
      }
    ]
  }
}
