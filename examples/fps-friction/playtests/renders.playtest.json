{
  "name": "fps-friction-renders",
  "schemaVersion": 1,
  "subject": "enemy",
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "artifacts": { "screenshots": true },
  "steps": [
    { "kind": "input", "label": "fire", "press": "Space", "holdTicks": 3, "release": true },
    { "kind": "wait", "label": "after-shot", "waitTicks": 60, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
