{
  "schemaVersion": 1,
  "name": "strata-terrain",
  "subject": "Baked terrain triangles and physics match during a playable 50 metre walk",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "warmupFrames": 90,
  "artifacts": {
    "screenshots": true,
    "console": true
  },
  "steps": [
    {
      "kind": "wait",
      "label": "grounded",
      "waitTicks": 120,
      "release": true,
      "screenshot": "forest-start"
    },
    {
      "kind": "input",
      "label": "meadow-close-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "meadow-close",
      "waitTicks": 150,
      "release": true,
      "screenshot": "meadow-close"
    },
    {
      "kind": "input",
      "label": "overview-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "overview",
      "waitTicks": 150,
      "release": true,
      "screenshot": "overview"
    },
    {
      "kind": "input",
      "label": "player-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "back-to-player",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk",
      "press": "KeyD",
      "holdTicks": 420,
      "release": true,
      "screenshot": "forest-walk"
    },
    {
      "label": "walk-distance",
      "waitForResource": {
        "id": "GameState",
        "path": "travel",
        "gte": 50
      },
      "timeoutMs": 5000,
      "release": true
    },
    {
      "kind": "input",
      "label": "coastal",
      "press": "KeyC",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ocean-early",
      "waitTicks": 180,
      "release": true,
      "screenshot": "coastal-ocean-early"
    },
    {
      "kind": "wait",
      "label": "ocean",
      "waitTicks": 180,
      "release": true,
      "screenshot": "coastal-ocean"
    },
    {
      "kind": "input",
      "label": "sun-change",
      "press": "KeyL",
      "holdTicks": 2,
      "release": true,
      "screenshot": "coastal-sun-alt"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "grounded",
        "equals": true,
        "allowTrivial": "The character settles during warmup; grounded must still hold after the walk and scene transition."
      },
      {
        "id": "GameState",
        "path": "maxContactError",
        "lte": 0.02,
        "allowTrivial": "Maximum measured error is a held upper bound; contactSamples separately requires fresh observations during the scenario."
      },
      {
        "id": "GameState",
        "path": "contactSamples",
        "gte": 300
      },
      {
        "id": "GameState",
        "path": "bilinearDifference",
        "gte": 0.1,
        "allowTrivial": "The asymmetric triangle fixture runs once after physics startup; its observed difference qualifies the sampling method."
      },
      {
        "id": "GameState",
        "path": "world",
        "equals": "coastal"
      },
      {
        "id": "GameState",
        "path": "oceanSteps",
        "gte": 300
      },
      {
        "id": "GameState",
        "path": "waveSamples",
        "gte": 2
      },
      {
        "id": "GameState",
        "path": "waveRange",
        "gte": 0.0001
      },
      {
        "id": "GameState",
        "path": "sampleSlopeRange",
        "gte": 0.0001
      },
      {
        "id": "GameState",
        "path": "sunX",
        "equals": 180,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "propInstances",
        "gte": 1000
      },
      {
        "id": "GameState",
        "path": "propDraws",
        "lte": 24
      },
      {
        "id": "GameState",
        "path": "propTriangles",
        "gte": 100000
      },
      {
        "id": "GameState",
        "path": "windowDrawCalls",
        "gte": 1
      }
    ]
  }
}
