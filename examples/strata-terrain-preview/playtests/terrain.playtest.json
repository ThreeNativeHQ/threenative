{
  "schemaVersion": 1,
  "name": "strata-terrain",
  "subject": "Baked terrain triangles and physics match during a playable 50 metre walk",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "warmupFrames": 90,
  "artifacts": {
    "screenshots": true,
    "console": true
  },
  "steps": [
    {
      "kind": "wait",
      "label": "grounded",
      "waitTicks": 120,
      "release": true,
      "screenshot": "forest-start"
    },
    {
      "kind": "input",
      "label": "meadow-close-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "meadow-close",
      "waitTicks": 150,
      "release": true,
      "screenshot": "meadow-close"
    },
    {
      "kind": "input",
      "label": "overview-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "overview",
      "waitTicks": 150,
      "release": true,
      "screenshot": "overview"
    },
    {
      "kind": "input",
      "label": "river-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "river",
      "waitTicks": 150,
      "release": true,
      "screenshot": "river"
    },
    {
      "kind": "input",
      "label": "player-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "back-to-player",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk",
      "press": "KeyD",
      "holdTicks": 420,
      "release": true,
      "screenshot": "forest-walk"
    },
    {
      "label": "walk-distance",
      "waitForResource": {
        "id": "GameState",
        "path": "travel",
        "gte": 50
      },
      "timeoutMs": 5000,
      "release": true
    },
    {
      "kind": "input",
      "label": "coastal",
      "press": "KeyC",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ocean-early",
      "waitTicks": 180,
      "release": true,
      "screenshot": "coastal-ocean-early"
    },
    {
      "kind": "wait",
      "label": "ocean",
      "waitTicks": 180,
      "release": true,
      "screenshot": "coastal-ocean"
    },
    {
      "kind": "input",
      "label": "horizon-sea-view-1",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "horizon-sea-view-2",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "horizon-sea-view-3",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "horizon-sea",
      "waitTicks": 150,
      "release": true,
      "screenshot": "coastal-horizon-sea"
    },
    {
      "kind": "input",
      "label": "coastal-player-view",
      "press": "KeyV",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "coastal-player",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "sun-change",
      "press": "KeyL",
      "holdTicks": 2,
      "release": true,
      "screenshot": "coastal-sun-alt"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "grounded",
        "equals": true,
        "allowTrivial": "The character settles during warmup; grounded must still hold after the walk and scene transition."
      },
      {
        "id": "GameState",
        "path": "maxContactError",
        "lte": 0.02,
        "allowTrivial": "Maximum measured error is a held upper bound; contactSamples separately requires fresh observations during the scenario."
      },
      {
        "id": "GameState",
        "path": "contactSamples",
        "gte": 300
      },
      {
        "id": "GameState",
        "path": "bilinearDifference",
        "gte": 0.1,
        "allowTrivial": "The asymmetric triangle fixture runs once after physics startup; its observed difference qualifies the sampling method."
      },
      {
        "id": "GameState",
        "path": "world",
        "equals": "coastal"
      },
      {
        "id": "GameState",
        "path": "oceanSteps",
        "gte": 300
      },
      {
        "id": "GameState",
        "path": "waveSamples",
        "gte": 2
      },
      {
        "id": "GameState",
        "path": "waveRange",
        "gte": 0.0001
      },
      {
        "id": "GameState",
        "path": "sampleSlopeRange",
        "gte": 0.0001
      },
      {
        "id": "GameState",
        "path": "sunX",
        "equals": 180,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "propInstances",
        "gte": 1000,
        "allowTrivial": "A steady-state bound on what is drawn, not a transition: the props are placed on the first physics step, which the warmup frames already cover, so the count holds before and after by construction."
      },
      {
        "id": "GameState",
        "path": "propDraws",
        "lte": 56,
        "allowTrivial": "A ceiling on the prop draws, which holds for every frame rather than changing at one: its value is the price of the instancing, and a run that only ever saw it once would prove nothing."
      },
      {
        "id": "GameState",
        "path": "propTriangles",
        "gte": 100000,
        "allowTrivial": "A floor on the geometry actually submitted, which holds for every frame for the same reason as the instance count."
      },
      {
        "id": "GameState",
        "path": "windowDrawCalls",
        "gte": 1
      },
      {
        "id": "GameState",
        "path": "preparedLodBaseSpread",
        "lte": 0.05,
        "allowTrivial": "The widest gap between two detail levels' own base Y in one prepared variant, measured on the geometry that is actually drawn. A level authored off the ground draws a crown floating above a neighbour that stands correctly, and grounding cannot fix it because grounding measures the trunk the levels share. Zero on a machine with no prepared art, which is why this is a ceiling and not a floor."
      },
      {
        "id": "GameState",
        "path": "preparedLevelsWithoutSolid",
        "lte": 0,
        "allowTrivial": "Detail levels carrying no bark or stone part at all. A cutout-only level is a crown with nothing holding it up, which is the same defect seen from the other side; the far cross-card is exempt because its trunk is baked into its own pixels. Fails closed on a prep that drops a trunk, which no diff shows and every capture does."
      },
      {
        "id": "GameState",
        "path": "meadowFrameP50",
        "gte": 0.01,
        "allowTrivial": "Frame cost at the meadow framing, the nearest look at the trees. A real measurement needs at least one closed budget window at that view; zero means the window never closed while it was on screen."
      },
      {
        "id": "GameState",
        "path": "overviewFrameP50",
        "gte": 0.01,
        "allowTrivial": "Frame cost at the overview framing, where the far impostor band carries most of the forest. Zero means no window closed at that view."
      },
      {
        "id": "GameState",
        "path": "meadowTriangles",
        "gte": 1000,
        "allowTrivial": "Triangles submitted at the meadow framing. A floor on real geometry, so a run that reported zero could not be the picture the trees are judged in."
      },
      {
        "id": "GameState",
        "path": "overviewTriangles",
        "gte": 1000,
        "allowTrivial": "Triangles submitted at the overview framing, where the LOD bands are supposed to have replaced most of the near geometry."
      }
    ]
  }
}
