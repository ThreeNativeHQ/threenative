{
  "schemaVersion": 1,
  "name": "native-physics-rest-collision",
  "target": "web",
  "subject": "dynamicBox",
  "viewport": { "width": 640, "height": 360 },
  "warmupFrames": 0,
  "steps": [{ "waitFrames": 180, "label": "settled" }],
  "artifacts": { "screenshots": false },
  "assert": {
    "movement": {
      "entity": "dynamicBox",
      "minDistance": 2,
      "reachesPositionWithin": {
        "position": [0.7, 0.4, 0],
        "maxDistance": 0.05,
        "atStep": "settled"
      }
    },
    "resources": [
      { "id": "GameState", "path": "parity.steps", "equals": 180, "changed": true },
      { "id": "GameState", "path": "parity.grounded", "equals": true, "changed": true }
    ]
  }
}
