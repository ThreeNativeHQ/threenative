{
  "schemaVersion": 1,
  "name": "native-physics-collision-mask",
  "target": "web",
  "subject": "dynamicBox",
  "viewport": { "width": 640, "height": 360 },
  "warmupFrames": 0,
  "steps": [{ "waitFrames": 180, "label": "fell-through" }],
  "artifacts": { "screenshots": false },
  "assert": {
    "movement": { "entity": "dynamicBox", "minDistance": 5 },
    "resources": [
      { "id": "GameState", "path": "parity.collisionEventSet", "equals": [], "allowTrivial": true },
      {
        "id": "GameState",
        "path": "parity.control",
        "equals": "masked",
        "changed": false,
        "allowTrivial": true
      }
    ]
  }
}
