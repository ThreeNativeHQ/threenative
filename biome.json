{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist/**",
      "packages/playtest/**",
      "test-results/**",
      "examples/abyss-vanilla/index.html",
      "examples/abyss-vanilla/src/main.js",
      "examples/abyss-vanilla/src/style.css",
      "examples/abyss-vanilla/vite.config.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
