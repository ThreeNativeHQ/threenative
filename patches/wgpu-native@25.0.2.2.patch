 pub struct WGPUInstanceImpl {
     context: Arc<Context>,
+}
+
+pub struct WGPUPipelineCacheImpl {
+    context: Arc<Context>,
+    device_id: id::DeviceId,
+    id: id::PipelineCacheId,
+}
+impl Drop for WGPUPipelineCacheImpl {
+    fn drop(&mut self) {
+        if !thread::panicking() { self.context.pipeline_cache_drop(self.id); }
+    }
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceCreatePipelineCache(
+    device: native::WGPUDevice,
+    descriptor: Option<&native::WGPUPipelineCacheDescriptor>,
+) -> native::WGPUPipelineCache {
+    let Some(device) = device.as_ref() else { return std::ptr::null(); };
+    let Some(descriptor) = descriptor else { return std::ptr::null(); };
+    if descriptor.size > 64 * 1024 * 1024 || (descriptor.size != 0 && descriptor.data.is_null()) {
+        return std::ptr::null();
+    }
+    let desc = wgc::pipeline::PipelineCacheDescriptor {
+        label: string_view_into_label(descriptor.label),
+        data: if descriptor.size == 0 { None } else {
+            Some(std::borrow::Cow::Borrowed(make_slice(descriptor.data, descriptor.size)))
+        },
+        fallback: false,
+    };
+    let (id, error) = device.context.device_create_pipeline_cache(device.id, &desc, None);
+    if let Some(error) = error {
+        log::warn!("wgpuDeviceCreatePipelineCache rejected: {error}");
+        device.context.pipeline_cache_drop(id);
+        return std::ptr::null();
+    }
+    Arc::into_raw(Arc::new(WGPUPipelineCacheImpl {
+        context: device.context.clone(), device_id: device.id, id,
+    }))
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wgpuPipelineCacheAddRef(cache: native::WGPUPipelineCache) {
+    if !cache.is_null() { Arc::increment_strong_count(cache); }
+}
+#[no_mangle]
+pub unsafe extern "C" fn wgpuPipelineCacheRelease(cache: native::WGPUPipelineCache) {
+    if !cache.is_null() { Arc::decrement_strong_count(cache); }
+}
+#[no_mangle]
+pub unsafe extern "C" fn wgpuPipelineCacheGetData(cache: native::WGPUPipelineCache) -> native::WGPUPipelineCacheData {
+    let empty = native::WGPUPipelineCacheData { data: std::ptr::null(), size: 0 };
+    let Some(cache) = cache.as_ref() else { return empty; };
+    let Some(data) = cache.context.pipeline_cache_get_data(cache.id) else { return empty; };
+    if data.is_empty() || data.len() > 64 * 1024 * 1024 { return empty; }
+    let data = data.into_boxed_slice();
+    let size = data.len();
+    let data = Box::into_raw(data) as *const u8;
+    native::WGPUPipelineCacheData { data, size }
+}
+#[no_mangle]
+pub unsafe extern "C" fn wgpuPipelineCacheDataFreeMembers(data: native::WGPUPipelineCacheData) {
+    if !data.data.is_null() {
+        drop(Box::from_raw(std::ptr::slice_from_raw_parts_mut(data.data as *mut u8, data.size)));
+    }
+}
+
+unsafe fn pipeline_cache_id(
+    mut chain: *const native::WGPUChainedStruct, context: &Arc<Context>, device_id: id::DeviceId,
+) -> Result<Option<id::PipelineCacheId>, &'static str> {
+    let mut found = None;
+    let mut length = 0;
+    while let Some(item) = chain.as_ref() {
+        length += 1;
+        if length > 64 { return Err("pipeline descriptor chain exceeds limit"); }
+        if item.sType == native::WGPUSType_PipelineCacheExtras {
+            if found.is_some() { return Err("duplicate pipeline cache extension"); }
+            let extra = &*(chain as *const native::WGPUPipelineCacheExtras);
+            let Some(cache) = extra.cache.as_ref() else { return Err("null pipeline cache"); };
+            if !Arc::ptr_eq(context, &cache.context) || device_id != cache.device_id {
+                return Err("pipeline cache belongs to another device");
+            }
+            found = Some(cache.id);
+        }
+        chain = item.next;
+    }
+    Ok(found)
 }
 
